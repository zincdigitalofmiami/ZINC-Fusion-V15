generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "raw"]
}

// === RAW SCHEMA TABLES ===

model MarketFuturesDaily {
  asOfDate   DateTime @map("as_of_date") @db.Date
  symbol     String
  open       Float?
  high       Float?
  low        Float?
  close      Float?
  volume     BigInt?
  source     String?
  ingestedAt DateTime? @default(now()) @map("ingested_at")

  @@id([asOfDate, symbol])
  @@schema("raw")
  @@map("market_futures_1d")
}

model FredEconomicWide {
  tradeDate DateTime @id @map("trade_date") @db.Date
  // FRED series columns added via custom migration

  @@schema("raw")
  @@map("fred_economic_wide_1d")
}

// === PUBLIC SCHEMA TABLES ===

model RawMarketFutures {
  id            Int      @id @default(autoincrement())
  symbol        String
  asOfDate      DateTime @map("as_of_date")
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Int?
  createdAt     DateTime @default(now()) @map("created_at")
  open_interest BigInt?

  @@unique([symbol, asOfDate])
  @@index([symbol])
  @@index([asOfDate])
  @@index([asOfDate], map: "idx_futures_date")
  @@index([symbol], map: "idx_futures_symbol")
  @@schema("public")
  @@map("raw_market_futures")
}

model RawFredObservations {
  id        Int      @id @default(autoincrement())
  seriesId  String   @map("series_id")
  asOfDate  DateTime @map("as_of_date")
  value     Float?
  createdAt DateTime @default(now()) @map("created_at")
  source    String?  @db.VarChar(50)

  @@unique([seriesId, asOfDate])
  @@index([seriesId])
  @@index([asOfDate])
  @@index([asOfDate], map: "idx_fred_date")
  @@index([seriesId], map: "idx_fred_series")
  @@schema("public")
  @@map("raw_fred_observations")
}

model RawFxSpot {
  id        Int      @id @default(autoincrement())
  pair      String
  asOfDate  DateTime @map("as_of_date")
  rate      Float
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([pair, asOfDate])
  @@index([pair])
  @@index([asOfDate])
  @@schema("public")
  @@map("raw_fx_spot")
}

model RawWeatherObservations {
  id        Int      @id @default(autoincrement())
  stationId String   @map("station_id")
  asOfDate  DateTime @map("as_of_date")
  tempMax   Float?   @map("temp_max")
  tempMin   Float?   @map("temp_min")
  precip    Float?
  humidity  Float?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([stationId, asOfDate])
  @@index([stationId])
  @@index([asOfDate])
  @@schema("public")
  @@map("raw_weather_observations")
}

model RawEpaRinPrices {
  id        Int      @id @default(autoincrement())
  rinType   String   @map("rin_type")
  asOfDate  DateTime @map("as_of_date")
  price     Float
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([rinType, asOfDate])
  @@index([rinType])
  @@index([asOfDate])
  @@schema("public")
  @@map("raw_epa_rin_prices")
}

model RawCftcCot {
  id                 Int      @id @default(autoincrement())
  contractCode       String   @map("contract_code")
  asOfDate           DateTime @map("as_of_date")
  commercialLong     Int?     @map("commercial_long")
  commercialShort    Int?     @map("commercial_short")
  nonCommercialLong  Int?     @map("non_commercial_long")
  nonCommercialShort Int?     @map("non_commercial_short")
  openInterest       Int?     @map("open_interest")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([contractCode, asOfDate])
  @@index([contractCode])
  @@index([asOfDate])
  @@schema("public")
  @@map("raw_cftc_cot")
}

model CvFolds {
  id       Int      @id @default(autoincrement())
  asOfDate DateTime @map("as_of_date")
  horizon  Int
  foldId   Int      @map("fold_id")
  isTrain  Boolean  @map("is_train")
  isVal    Boolean  @map("is_val")

  @@unique([asOfDate, horizon, foldId])
  @@index([horizon])
  @@index([asOfDate])
  @@schema("public")
  @@map("cv_folds")
}

model SpecialistFeatures {
  id       Int      @id @default(autoincrement())
  bucket   String
  asOfDate DateTime @map("as_of_date")
  features Json

  @@unique([bucket, asOfDate])
  @@index([bucket])
  @@index([asOfDate])
  @@schema("public")
  @@map("specialist_features")
}

model CoreFeatures {
  id       Int      @id @default(autoincrement())
  asOfDate DateTime @unique @map("as_of_date")
  features Json

  @@index([asOfDate])
  @@schema("public")
  @@map("core_features")
}

model OofPredictions {
  id           Int      @id @default(autoincrement())
  source       String
  asOfDate     DateTime @map("as_of_date")
  horizon      Int
  foldId       Int      @map("fold_id")
  p10          Float
  p50          Float
  p90          Float
  modelVersion String   @map("model_version")
  trainedAt    DateTime @map("trained_at")

  @@unique([source, asOfDate, horizon, foldId])
  @@index([source])
  @@index([horizon])
  @@index([asOfDate])
  @@schema("public")
  @@map("oof_predictions")
}

model LassoCoefficients {
  id           Int      @id @default(autoincrement())
  bucket       String
  horizon      Int
  featureName  String   @map("feature_name")
  coefficient  Float
  isActive     Boolean  @map("is_active")
  modelVersion String   @map("model_version")
  trainedAt    DateTime @map("trained_at")

  @@unique([bucket, horizon, featureName, modelVersion])
  @@index([bucket])
  @@index([horizon])
  @@index([isActive])
  @@schema("public")
  @@map("lasso_coefficients")
}

model MetaEnsemble {
  id           Int      @id @default(autoincrement())
  asOfDate     DateTime @map("as_of_date") @db.Timestamp(6)
  horizon      Int
  p10          Float
  p50          Float
  p90          Float
  modelVersion String   @map("model_version") @db.VarChar(100)
  trainedAt    DateTime @map("trained_at") @db.Timestamp(6)

  @@unique([asOfDate, horizon])
  @@index([horizon], map: "idx_meta_ensemble_horizon")
  @@schema("public")
  @@map("meta_ensemble")
}

model ForecastQuantiles {
  id         Int      @id @default(autoincrement())
  symbol     String
  asOfDate   DateTime @map("as_of_date")
  horizon    Int
  p10        Float
  p50        Float
  p90        Float
  probUp     Float    @map("prob_up")
  regime     String?
  confidence Float?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([symbol, asOfDate, horizon])
  @@index([symbol])
  @@index([horizon])
  @@index([asOfDate])
  @@schema("public")
  @@map("forecast_quantiles")
}

model DriverScores {
  id           Int      @id @default(autoincrement())
  symbol       String
  asOfDate     DateTime @map("as_of_date")
  bucket       String
  score        Float
  contribution Float
  direction    String
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([symbol, asOfDate, bucket])
  @@index([symbol])
  @@index([bucket])
  @@index([asOfDate])
  @@schema("public")
  @@map("driver_scores")
}

model ChartOverlays {
  id          Int       @id @default(autoincrement())
  symbol      String
  overlayType String    @map("overlay_type")
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  label       String
  color       String?
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([symbol])
  @@index([overlayType])
  @@index([startDate])
  @@schema("public")
  @@map("chart_overlays")
}

model ProcurementActions {
  id         Int      @id @default(autoincrement())
  symbol     String
  asOfDate   DateTime @map("as_of_date")
  action     String
  confidence Float
  rationale  String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([symbol, asOfDate])
  @@index([symbol])
  @@index([asOfDate])
  @@schema("public")
  @@map("procurement_actions")
}

model ValueTimingWindows {
  id                     Int      @id @default(autoincrement())
  symbol                 String
  asOfDate               DateTime @map("as_of_date")
  horizonDays            Int      @map("horizon_days")
  tailProximity          Float    @map("tail_proximity")
  probabilityLift        Float    @map("probability_lift")
  confidenceAdjustedLift Float    @map("confidence_adjusted_lift")
  regimeDampening        Float?   @map("regime_dampening")
  windowStartWeek        Int?     @map("window_start_week")
  windowEndWeek          Int?     @map("window_end_week")
  createdAt              DateTime @default(now()) @map("created_at")

  @@unique([symbol, asOfDate, horizonDays])
  @@index([symbol])
  @@index([horizonDays])
  @@index([asOfDate])
  @@schema("public")
  @@map("value_timing_windows")
}

model SpecialistDrivers {
  id          Int    @id @default(autoincrement())
  driverId    String @unique @map("driver_id")
  description String

  @@schema("public")
  @@map("specialist_drivers")
}

model RiskMetrics {
  id             Int       @id @default(autoincrement())
  asOfDate       DateTime  @map("as_of_date") @db.Timestamp(6)
  horizon        Int
  var_01         Float
  var_05         Float
  var_10         Float
  cvar_05        Float
  prob_up        Float
  prob_up_5pct   Float
  prob_down_5pct Float
  regime         String    @db.VarChar(20)
  tail_risk_flag Boolean
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([asOfDate, horizon])
  @@schema("public")
  @@map("risk_metrics")
}

model MonteCarloRuns {
  id           Int      @id @default(autoincrement())
  symbol       String
  asOfDate     DateTime @map("as_of_date")
  horizon      Int
  numSims      Int      @map("num_sims")
  percentiles  Json
  correlations Json?
  modelVersion String   @map("model_version")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([symbol, asOfDate, horizon, modelVersion])
  @@index([symbol])
  @@index([horizon])
  @@index([asOfDate])
  @@schema("public")
  @@map("monte_carlo_runs")
}

model ModelRegistry {
  id           Int      @id @default(autoincrement())
  modelId      String   @unique @map("model_id")
  source       String
  horizon      Int
  version      String
  trainedAt    DateTime @map("trained_at")
  metrics      Json
  artifactPath String   @map("artifact_path")
  foldId       Int?     @map("fold_id")
  isActive     Boolean  @default(true) @map("is_active")

  @@index([source])
  @@index([horizon])
  @@index([isActive])
  @@schema("public")
  @@map("model_registry")
}

model DataQualityLog {
  id         Int      @id @default(autoincrement())
  tableName  String   @map("table_name")
  checkDate  DateTime @map("check_date")
  rowCount   Int      @map("row_count")
  nullCount  Int      @map("null_count")
  latestDate DateTime @map("latest_date")
  oldestDate DateTime @map("oldest_date")
  issues     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tableName])
  @@index([checkDate])
  @@schema("public")
  @@map("data_quality_log")
}

model TrainingRunLog {
  id           Int       @id @default(autoincrement())
  runId        String    @unique @map("run_id")
  horizon      Int
  phase        String
  status       String
  startedAt    DateTime  @map("started_at")
  completedAt  DateTime? @map("completed_at")
  errorMessage String?   @map("error_message")
  metrics      Json?

  @@index([horizon])
  @@index([phase])
  @@index([status])
  @@schema("public")
  @@map("training_run_log")
}

model OptionsGreeks {
  id              Int       @id @default(autoincrement())
  instrument_id   BigInt?
  raw_symbol      String?   @db.VarChar(50)
  underlying      String?   @db.VarChar(10)
  asOfDate        DateTime? @map("as_of_date") @db.Date
  expirationDate  DateTime? @map("expiration_date") @db.Date
  strikePrice     Decimal?  @map("strike_price") @db.Decimal(12, 4)
  optionType      String?   @map("option_type") @db.VarChar(1)
  open            Decimal?  @db.Decimal(10, 4)
  high            Decimal?  @db.Decimal(10, 4)
  low             Decimal?  @db.Decimal(10, 4)
  close           Decimal?  @db.Decimal(10, 4)
  volume          BigInt?
  openInterest    BigInt?   @map("open_interest")
  underlyingPrice Decimal?  @map("underlying_price") @db.Decimal(10, 4)
  risk_free_rate  Decimal?  @db.Decimal(8, 6)
  impliedVol      Decimal?  @map("implied_volatility") @db.Decimal(8, 6)
  delta           Decimal?  @db.Decimal(8, 6)
  gamma           Decimal?  @db.Decimal(10, 8)
  theta           Decimal?  @db.Decimal(10, 6)
  vega            Decimal?  @db.Decimal(10, 6)
  daysToExpiry    Int?      @map("days_to_expiry")
  moneyness       String?   @db.VarChar(10)
  expiryBucket    String?   @map("expiry_bucket") @db.VarChar(5)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([instrument_id, asOfDate])
  @@index([asOfDate], map: "idx_options_greeks_date")
  @@index([expiryBucket], map: "idx_options_greeks_expiry")
  @@index([moneyness], map: "idx_options_greeks_moneyness")
  @@index([underlying], map: "idx_options_greeks_underlying")
  @@schema("public")
  @@map("options_greeks")
}

model OptionsFeatures {
  id                  Int       @id @default(autoincrement())
  underlying          String?   @db.VarChar(10)
  asOfDate            DateTime? @map("as_of_date") @db.Date
  expiryBucket        String?   @map("expiry_bucket") @db.VarChar(5)
  ivAtmCall           Decimal?  @map("iv_atm_call") @db.Decimal(8, 6)
  ivAtmPut            Decimal?  @map("iv_atm_put") @db.Decimal(8, 6)
  ivSkew              Decimal?  @map("iv_skew") @db.Decimal(8, 6)
  ivTermStructure     Decimal?  @map("iv_term_structure") @db.Decimal(8, 6)
  ivPercentile30d     Decimal?  @map("iv_percentile_30d") @db.Decimal(5, 2)
  ivRank              Decimal?  @map("iv_rank") @db.Decimal(5, 2)
  deltaWeightedOiCall Decimal?  @map("delta_weighted_oi_call") @db.Decimal(18, 4)
  deltaWeightedOiPut  Decimal?  @map("delta_weighted_oi_put") @db.Decimal(18, 4)
  gammaExposure       Decimal?  @map("gamma_exposure") @db.Decimal(18, 4)
  netGamma            Decimal?  @map("net_gamma") @db.Decimal(18, 4)
  vegaExposure        Decimal?  @map("vega_exposure") @db.Decimal(18, 4)
  thetaDecay          Decimal?  @map("theta_decay") @db.Decimal(18, 4)
  putCallRatioVolume  Decimal?  @map("put_call_ratio_volume") @db.Decimal(8, 4)
  putCallRatioOi      Decimal?  @map("put_call_ratio_oi") @db.Decimal(8, 4)
  totalVolume         BigInt?   @map("total_volume")
  totalOpenInterest   BigInt?   @map("total_open_interest")
  skewZscore          Decimal?  @map("skew_zscore") @db.Decimal(6, 4)
  gammaFlipLevel      Decimal?  @map("gamma_flip_level") @db.Decimal(10, 4)
  maxPainStrike       Decimal?  @map("max_pain_strike") @db.Decimal(10, 4)
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([underlying, asOfDate, expiryBucket])
  @@index([asOfDate], map: "idx_options_features_date")
  @@index([underlying], map: "idx_options_features_underlying")
  @@schema("public")
  @@map("options_features")
}

model VolatilitySurface {
  id           Int       @id @default(autoincrement())
  underlying   String?   @db.VarChar(10)
  asOfDate     DateTime? @map("as_of_date") @db.Date
  surfaceData  Json?     @map("surface_data")
  atmVol       Decimal?  @map("atm_vol") @db.Decimal(8, 6)
  skew25d      Decimal?  @map("skew_25d") @db.Decimal(8, 6)
  butterfly25d Decimal?  @map("butterfly_25d") @db.Decimal(8, 6)
  termSlope    Decimal?  @map("term_slope") @db.Decimal(8, 6)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([underlying, asOfDate])
  @@index([asOfDate], map: "idx_vol_surface_date")
  @@index([underlying], map: "idx_vol_surface_underlying")
  @@schema("public")
  @@map("volatility_surface")
}

model cftc_cot {
  id                       Int       @id @default(autoincrement())
  report_date              DateTime  @db.Date
  symbol                   String    @db.VarChar(20)
  open_interest            BigInt?
  prod_merc_long           BigInt?
  prod_merc_short          BigInt?
  swap_long                BigInt?
  swap_short               BigInt?
  managed_money_long       BigInt?
  managed_money_short      BigInt?
  other_rept_long          BigInt?
  other_rept_short         BigInt?
  nonrept_long             BigInt?
  nonrept_short            BigInt?
  prod_merc_net            BigInt?
  swap_net                 BigInt?
  managed_money_net        BigInt?
  other_rept_net           BigInt?
  nonrept_net              BigInt?
  managed_money_net_pct_oi Float?
  prod_merc_net_pct_oi     Float?
  source                   String?   @db.VarChar(50)
  ingested_at              DateTime? @default(now()) @db.Timestamp(6)

  @@unique([report_date, symbol])
  @@index([report_date], map: "idx_cftc_date")
  @@index([symbol], map: "idx_cftc_symbol")
  @@schema("public")
}

model fred_series_metadata {
  id                  Int       @id @default(autoincrement())
  series_id           String    @unique @db.VarChar(50)
  title               String?   @db.VarChar(500)
  observation_start   DateTime? @db.Date
  observation_end     DateTime? @db.Date
  frequency           String?   @db.VarChar(50)
  units               String?   @db.VarChar(200)
  seasonal_adjustment String?   @db.VarChar(100)
  last_updated        DateTime? @db.Timestamp(6)
  source              String?   @db.VarChar(200)
  notes               String?
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  @@schema("public")
}

model meta_weights {
  id            Int      @id @default(autoincrement())
  source        String   @db.VarChar(50)
  horizon       Int
  weight        Float
  model_version String   @db.VarChar(100)
  trained_at    DateTime @db.Timestamp(6)

  @@unique([source, horizon, model_version])
  @@index([horizon], map: "idx_meta_weights_horizon")
  @@schema("public")
}

model raw_options_futures {
  id            Int       @id @default(autoincrement())
  symbol        String    @db.VarChar(50)
  as_of_date    DateTime  @db.Date
  open          Float?
  high          Float?
  low           Float?
  close         Float?
  volume        BigInt?
  open_interest BigInt?
  expiration    DateTime? @db.Date
  strike        Float?
  option_type   String?   @db.VarChar(10)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@unique([symbol, as_of_date])
  @@index([as_of_date], map: "idx_options_date")
  @@index([symbol], map: "idx_options_symbol")
  @@schema("public")
}

model usda_export_sales {
  id                   Int       @id @default(autoincrement())
  report_date          DateTime  @db.Date
  commodity            String    @db.VarChar(100)
  destination_country  String?   @db.VarChar(100)
  net_sales_mt         Float?
  exports_mt           Float?
  outstanding_sales_mt Float?
  source               String?   @db.VarChar(50)
  ingested_at          DateTime? @default(now()) @db.Timestamp(6)

  @@unique([report_date, commodity, destination_country])
  @@index([commodity], map: "idx_usda_commodity")
  @@index([report_date], map: "idx_usda_date")
  @@index([commodity], map: "idx_usda_exports_commodity")
  @@index([report_date], map: "idx_usda_exports_date")
  @@schema("public")
}

model usda_wasde {
  id          Int       @id @default(autoincrement())
  report_date DateTime  @db.Date
  commodity   String    @db.VarChar(100)
  country     String?   @db.VarChar(100)
  metric      String?   @db.VarChar(200)
  value       Float?
  unit        String?   @db.VarChar(50)
  source      String?   @db.VarChar(50)
  ingested_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([report_date, commodity, country, metric])
  @@index([commodity], map: "idx_wasde_commodity")
  @@index([report_date], map: "idx_wasde_date")
  @@schema("public")
}

model weather_noaa {
  id                Int       @id @default(autoincrement())
  station_id        String    @db.VarChar(50)
  as_of_date        DateTime  @db.Date
  tavg_c            Float?
  tmin_c            Float?
  tmax_c            Float?
  prcp_mm           Float?
  snow_mm           Float?
  region            String?   @db.VarChar(100)
  ingested_at       DateTime? @default(now()) @db.Timestamp(6)
  awnd_ms           Float?
  specialist_bucket String?   @db.VarChar(50)
  country           String?   @db.VarChar(50)

  @@unique([station_id, as_of_date])
  @@index([specialist_bucket], map: "idx_weather_bucket")
  @@index([as_of_date], map: "idx_weather_date")
  @@index([region], map: "idx_weather_region")
  @@schema("public")
}

model dashboard_metrics {
  id          Int       @id @default(autoincrement())
  metric_type String    @db.VarChar(50)
  as_of_date  DateTime  @db.Date
  symbol      String?   @db.VarChar(20)
  horizon     Int?
  value       Float?
  metadata    Json?
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  @@unique([metric_type, as_of_date, symbol, horizon])
  @@index([as_of_date], map: "idx_dashboard_date")
  @@index([metric_type], map: "idx_dashboard_type")
  @@schema("public")
}

model garch_forecasts {
  id              Int       @id @default(autoincrement())
  symbol          String    @db.VarChar(20)
  as_of_date      DateTime  @db.Date
  horizon         Int
  conditional_vol Float
  annualized_vol  Float
  var_01          Float?
  var_05          Float?
  cvar_05         Float?
  vol_lower       Float?
  vol_upper       Float?
  model_type      String?   @db.VarChar(50)
  model_version   String?   @db.VarChar(100)
  created_at      DateTime? @default(now()) @db.Timestamp(6)

  @@unique([symbol, as_of_date, horizon, model_version])
  @@index([as_of_date], map: "idx_garch_forecast_date")
  @@index([symbol], map: "idx_garch_forecast_symbol")
  @@schema("public")
}

model garch_parameters {
  id             Int       @id @default(autoincrement())
  symbol         String    @db.VarChar(20)
  model_type     String    @db.VarChar(50)
  p              Int
  q              Int
  omega          Float
  alpha          Json
  beta           Json
  gamma          Json?
  distribution   String?   @db.VarChar(20)
  df             Float?
  log_likelihood Float?
  aic            Float?
  bic            Float?
  model_version  String?   @db.VarChar(100)
  trained_at     DateTime? @db.Timestamp(6)
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  @@unique([symbol, model_type, p, q, model_version])
  @@index([symbol], map: "idx_garch_params_symbol")
  @@schema("public")
}

model probability_distributions {
  id            Int       @id @default(autoincrement())
  symbol        String    @db.VarChar(20)
  as_of_date    DateTime  @db.Date
  horizon       Int
  percentile    Float
  value         Float
  model_version String?   @db.VarChar(100)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@unique([symbol, as_of_date, horizon, percentile])
  @@index([as_of_date], map: "idx_prob_dist_date")
  @@index([symbol], map: "idx_prob_dist_symbol")
  @@schema("public")
}

model realized_volatility {
  id               Int       @id @default(autoincrement())
  symbol           String    @db.VarChar(20)
  as_of_date       DateTime  @db.Date
  window_days      Int
  realized_vol     Float
  parkinson_vol    Float?
  garman_klass_vol Float?
  yang_zhang_vol   Float?
  annualized       Boolean?  @default(true)
  created_at       DateTime? @default(now()) @db.Timestamp(6)

  @@unique([symbol, as_of_date, window_days])
  @@index([as_of_date], map: "idx_realized_vol_date")
  @@index([symbol], map: "idx_realized_vol_symbol")
  @@schema("public")
}

model regime_probabilities {
  id            Int       @id @default(autoincrement())
  as_of_date    DateTime  @db.Date
  regime_type   String    @db.VarChar(50)
  regime_name   String    @db.VarChar(100)
  probability   Float
  confidence    Float?
  drivers       Json?
  model_version String?   @db.VarChar(100)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@unique([as_of_date, regime_type, regime_name])
  @@index([as_of_date], map: "idx_regime_prob_date")
  @@schema("public")
}

model scenario_analysis {
  id                Int       @id @default(autoincrement())
  scenario_id       String    @db.VarChar(100)
  scenario_name     String    @db.VarChar(200)
  as_of_date        DateTime  @db.Date
  horizon           Int
  assumptions       Json
  base_forecast     Float?
  scenario_forecast Float?
  impact_pct        Float?
  probability       Float?
  confidence        String?   @db.VarChar(20)
  model_version     String?   @db.VarChar(100)
  created_at        DateTime? @default(now()) @db.Timestamp(6)

  @@unique([scenario_id, as_of_date, horizon])
  @@index([as_of_date], map: "idx_scenario_date")
  @@schema("public")
}

model shap_summary {
  id            Int       @id @default(autoincrement())
  horizon       Int
  feature_name  String    @db.VarChar(100)
  mean_abs_shap Float
  std_shap      Float?
  rank          Int?
  model_version String?   @db.VarChar(100)
  trained_at    DateTime? @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@unique([horizon, feature_name, model_version])
  @@index([horizon], map: "idx_shap_summary_horizon")
  @@schema("public")
}

model shap_values {
  id            Int       @id @default(autoincrement())
  as_of_date    DateTime  @db.Date
  horizon       Int
  feature_name  String    @db.VarChar(100)
  shap_value    Float
  base_value    Float?
  prediction    Float?
  model_version String?   @db.VarChar(100)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@unique([as_of_date, horizon, feature_name, model_version])
  @@index([as_of_date], map: "idx_shap_values_date")
  @@index([horizon], map: "idx_shap_values_horizon")
  @@schema("public")
}

model vol_regimes {
  id               Int       @id @default(autoincrement())
  symbol           String    @db.VarChar(20)
  as_of_date       DateTime  @db.Date
  regime           String    @db.VarChar(20)
  regime_prob      Float?
  transition_probs Json?
  smoothed_prob    Float?
  model_type       String?   @db.VarChar(50)
  model_version    String?   @db.VarChar(100)
  created_at       DateTime? @default(now()) @db.Timestamp(6)

  @@unique([symbol, as_of_date, model_version])
  @@index([as_of_date], map: "idx_vol_regime_date")
  @@index([symbol], map: "idx_vol_regime_symbol")
  @@schema("public")
}
