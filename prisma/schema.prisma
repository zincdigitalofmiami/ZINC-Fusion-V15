  sourceName           String    @map("source_name")
  description          String?
  targetTable          String    @map("target_table")
  targetSchema         String    @default("raw") @map("target_schema")
  apiProvider          String    @map("api_provider")
  apiEndpoint          String    @map("api_endpoint")
  apiDocsUrl           String?   @map("api_docs_url")
  authType             String?   @map("auth_type")
  authEnvVar           String?   @map("auth_env_var")
  responseFormat       String?   @map("response_format")
  dateColumn           String?   @map("date_column")
  entityColumn         String?   @map("entity_column")
  updateFrequency      String    @map("update_frequency")
  typicalLagHours      Int?      @map("typical_lag_hours")
