  modelType       String?   @map("model_type") @db.VarChar
  modelVersion    String?   @map("model_version") @db.VarChar
  createdAt       DateTime? @default(now()) @map("created_at")

  @@unique([symbol, asOfDate, modelVersion])
  @@map("vol_regimes")
  @@schema("analytics")
}

