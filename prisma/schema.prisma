model MktOptions1d {
  id                Int       @id @default(autoincrement())
  underlying        String    @db.VarChar(20)
  eventDate         DateTime  @map("event_date") @db.Date
  expiration        DateTime  @db.Date
  strike            Float
  optionType        String    @map("option_type") @db.VarChar(4)
  open              Float?
  high              Float?
  low               Float?
  close             Float?
  change            Float?
  bid               Float?
  ask               Float?
  volume            BigInt?
  openInterest      BigInt?   @map("open_interest")
  premium           Float?
  // Databento statistics schema - all 15 stat types (stat_type 1-15)
  openingPriceStat  Float?    @map("opening_price_stat") // 1
  indicativeOpening Float?    @map("indicative_opening") // 2
  sessionLowStat    Float?    @map("session_low_stat") // 4
  sessionHighStat   Float?    @map("session_high_stat") // 5
  clearedVolume     BigInt?   @map("cleared_volume") // 6
  fixingPrice       Float?    @map("fixing_price") // 10
  closeStat         Float?    @map("close_stat") // 11
  vwap              Float?    @map("vwap") // 13
  impliedVolatility Float?    @map("implied_volatility") // 14
  delta             Float?    @map("delta") // 15
  // Calculated VWAP approximations (since Databento doesn't provide true VWAP)
  closeVwap         Float?    @map("close_vwap") // Close × Volume approximation
  ohlcAvgVwap       Float?    @map("ohlc_avg_vwap") // OHLC average × Volume approximation
  lastTradeTime     String?   @map("last_trade_time") @db.VarChar(20)
  source            String?   @default("barchart") @db.VarChar(50)
  ingestedAt        DateTime? @default(now()) @map("ingested_at") @db.Timestamptz(6)
  rowHash           String    @map("row_hash") @db.VarChar(64)

