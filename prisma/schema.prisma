generator client {
  provider        = "prisma-client-js"
  output          = "./generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["alt", "analytics", "econ", "features", "forecasts", "mkt", "model", "ops", "pos", "supply", "training", "vegas"]
}

