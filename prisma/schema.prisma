generator client {
  provider        = "prisma-client-js"
  output          = "./generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["alt", "analytics", "archive", "econ", "features", "forecasts", "metadata", "mkt", "model", "ops", "pos", "supply", "training"]
}

