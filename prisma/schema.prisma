  updated_at        DateTime? @default(now()) @db.Timestamptz(6)

  @@index([latitude, longitude], map: "idx_vegas_venues_coords")
  @@index([name], map: "idx_vegas_venues_name")
  @@index([placekey], map: "idx_vegas_venues_placekey")
  @@schema("vegas")
}

model model_runs {
  id             Int       @id @default(autoincrement())
  model_name     String    @db.VarChar(100)
  model_nickname String?   @db.VarChar(100)
  horizon_days   Int
  trained_date   String    @db.VarChar(10)
  run_hash       String    @db.VarChar(64)
  mae            Float?
  coverage_30_70 Float?
  oof_count      Int?
  status         String?   @default("experimental") @db.VarChar(20)
  outcome        String?   @default("pending") @db.VarChar(10)
  model_path     String?
  notes          String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  @@unique([run_hash, horizon_days])
  @@index([model_name, horizon_days], map: "idx_model_runs_model")
  @@index([status, outcome], map: "idx_model_runs_status")
  @@schema("training")
}

model specialist_signals_1d {
  id         Int       @id @default(autoincrement())
  as_of_date DateTime  @db.Date
  bucket     String    @db.VarChar(30)
  signal_1   Float
  signal_2   Float?
  confidence Float?
  model_type String    @db.VarChar(50)
  run_hash   String    @db.VarChar(64)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([as_of_date, bucket])
  @@index([as_of_date], map: "idx_specialist_signals_date")
  @@index([bucket], map: "idx_specialist_signals_bucket")
  @@index([run_hash], map: "idx_specialist_signals_run")
  @@schema("training")
}

model AblationResults {
  id                   Int      @id @default(autoincrement())
  runId                String   @map("run_id") @db.VarChar(64)
  bucket               String   @db.VarChar(30)
  horizonDays          Int      @map("horizon_days")
  baselineMae          Float    @map("baseline_mae")
  withSignalMae        Float    @map("with_signal_mae")
  deltaMae             Float    @map("delta_mae")
  baselineCoverage40   Float    @map("baseline_coverage_40")
  withSignalCoverage40 Float    @map("with_signal_coverage_40")
  regimeStabilityScore Float?   @map("regime_stability_score")
  recommendation       String   @db.VarChar(20)
  testedAt             DateTime @default(now()) @map("tested_at") @db.Timestamp(6)

  @@unique([runId, bucket, horizonDays])
  @@index([bucket], map: "idx_ablation_bucket")
  @@index([horizonDays], map: "idx_ablation_horizon")
  @@map("ablation_results")
  @@schema("analytics")
}

/// Board Crush & Oil Share Daily Calculations
/// Derived from ZS/ZL/ZM closes in mkt.futures_1d
/// Formula: board_crush = ZS - (ZL * 0.11) - (ZM * 0.022)
/// Formula: oil_share = (ZL * 0.11) / ((ZL * 0.11) + (ZM * 0.022))
model AnalyticsBoardCrush1d {
  tradeDate   DateTime  @id @map("trade_date") @db.Date
  zsClose     Decimal   @map("zs_close") @db.Decimal(10, 4)
  zlClose     Decimal   @map("zl_close") @db.Decimal(10, 4)
  zmClose     Decimal   @map("zm_close") @db.Decimal(10, 4)
  boardCrush  Decimal   @map("board_crush") @db.Decimal(10, 4)
  oilShare    Decimal   @map("oil_share") @db.Decimal(10, 6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tradeDate], map: "idx_analytics_board_crush_date")
  @@map("board_crush_1d")
  @@schema("analytics")
}
