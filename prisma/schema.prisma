model matrix_feature_stats_1d {
  id                 Int                @id @default(autoincrement())
  run_id             String             @db.Uuid
  column_name        String             @db.VarChar(100)
  dtype              String             @db.VarChar(20)
  p01                Float?
  p05                Float?
  p50                Float?
  p95                Float?
  p99                Float?
  mean               Float?
  std                Float?
  min_val            Float?
  max_val            Float?
  zero_rate          Float?
  missing_flag_rate  Float?
  age_days_p95       Int?
  release_day_rate   Float?
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  matrix_manifest_1d matrix_manifest_1d @relation(fields: [run_id], references: [run_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([run_id, column_name])
  @@schema("training")
}

