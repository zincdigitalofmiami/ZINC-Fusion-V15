model model_runs {
  id             Int       @id @default(autoincrement())
  model_name     String    @db.VarChar(100)
  model_nickname String?   @db.VarChar(100)
  horizon_days   Int
  trained_date   String    @db.VarChar(10)
  run_hash       String    @db.VarChar(64)
  mae            Float?
  coverage_30_70 Float?
  oof_count      Int?
  status         String?   @default("experimental") @db.VarChar(20)
  outcome        String?   @default("pending") @db.VarChar(10)
  model_path     String?
  notes          String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  @@unique([run_hash, horizon_days])
  @@index([model_name, horizon_days], map: "idx_model_runs_model")
  @@index([status, outcome], map: "idx_model_runs_status")
  @@schema("training")
}

model oof_biofuel_1d {
  id             Int      @id @default(autoincrement())
  trade_date     DateTime @db.Date
  symbol         String   @default("ZL") @db.VarChar(20)
  horizon_days   Int
  window_id      Int
  cutoff_date    DateTime @db.Date
  p30            Float
  p50            Float
  p70            Float
  target_value   Float?
  trained_at     DateTime @default(now()) @db.Timestamp(6)
  run_hash       String   @db.VarChar(64)
  matrix_version String?  @db.VarChar(64)

  @@unique([trade_date, symbol, horizon_days, window_id])
  @@index([trade_date], map: "idx_oof_biofuel_date")
  @@index([horizon_days], map: "idx_oof_biofuel_horizon")
  @@index([run_hash], map: "idx_oof_biofuel_run")
  @@schema("training")
}

