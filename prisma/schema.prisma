// =============================================================================
// MODEL CORE AUDIT (V15 Compliance Enforcement)
// =============================================================================
// Every Core training run must write exactly one audit row.
// CI and release gates read from this table.
// If this row says FAIL, the model does not exist operationally.

model ModelCoreAudit {
  id String @id @default(uuid())

  // Identity
  trainingRunId String   @unique @map("training_run_id")
  horizon       String // "5d" | "21d" | "63d" | "126d"
  reviewedAt    DateTime @default(now()) @map("reviewed_at")
  reviewer      String

  // -------- HARD GATES --------

  // Scope & CV
  isCoreRun           Boolean @map("is_core_run")
  cvPurgedWalkForward Boolean @map("cv_purged_walk_forward")
  asofAlignmentValid  Boolean @map("asof_alignment_valid")

  // Horizon allowlist
  chronosBoltPresent      Boolean @map("chronos_bolt_present")
  chronos2Present         Boolean @map("chronos2_present")
  chronos2LoraPresent     Boolean @map("chronos2_lora_present")
  recursiveTabularPresent Boolean @map("recursive_tabular_present")

  // Mandatory baselines
  autoetsPresent       Boolean @map("autoets_present")
  thetaPresent         Boolean @map("theta_present")
  seasonalNaivePresent Boolean @map("seasonal_naive_present")

  // Ensemble integrity
  weightedEnsembleUsed    Boolean @map("weighted_ensemble_used")
  oofOnly                 Boolean @map("oof_only")
  maxSingleWeight         Float   @map("max_single_weight")
  chronosWeightNonzero    Boolean @map("chronos_weight_nonzero")
  recursiveWeightZeroLong Boolean @map("recursive_weight_zero_long")

  // Probabilistic contract
  monteCarloRuns        Int     @map("monte_carlo_runs")
  p10Present            Boolean @map("p10_present")
  p50Present            Boolean @map("p50_present")
  p90Present            Boolean @map("p90_present")
  stressWideningApplied Boolean @map("stress_widening_applied")

  // Validation
  rmseRecorded  Boolean @map("rmse_recorded")
  brierRecorded Boolean @map("brier_recorded")
  p10CoverageOk Boolean @map("p10_coverage_ok")
  p90CoverageOk Boolean @map("p90_coverage_ok")

  // Registry & lineage
  registryComplete      Boolean @map("registry_complete")
  ensembleEdgesRecorded Boolean @map("ensemble_edges_recorded")
  resourcesLogged       Boolean @map("resources_logged")
  artifactIsolationSafe Boolean @map("artifact_isolation_safe")

  // -------- BUSINESS GATE --------
  narrativeReady           Boolean @map("narrative_ready")
  buySellLanguageAbsent    Boolean @map("buy_sell_language_absent")
  uncertaintyExplained     Boolean @map("uncertainty_explained")
  specialistDivergenceFlag Boolean @map("specialist_divergence_flag")

  // -------- FINAL VERDICT --------
  hardGatePass  Boolean @map("hard_gate_pass")
  finalApproved Boolean @map("final_approved")

  // Required on failure
  failureReason String? @map("failure_reason")

  @@index([horizon])
  @@index([finalApproved])
  @@map("model_core_audit")
  @@schema("model")
}

