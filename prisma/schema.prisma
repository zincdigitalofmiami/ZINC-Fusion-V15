// =============================================================================
// METADATA SCHEMA - Canonical Instrument & Source Governance
// =============================================================================

model Instrument {
  canonicalId   String   @id @map("canonical_id") @db.VarChar(50)
  assetClass    String   @map("asset_class") @db.VarChar(20)
  description   String   @db.Text
  primarySource String   @map("primary_source") @db.VarChar(50)
  unit          String?  @db.VarChar(20)
  currency      String?  @db.VarChar(3)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  mappings SymbolMapping[]

  @@map("instrument")
  @@schema("metadata")
}

model SymbolMapping {
  id               Int       @id @default(autoincrement())
  canonicalId      String    @map("canonical_id") @db.VarChar(50)
  sourceTable      String    @map("source_table") @db.VarChar(100)
  sourceSymbol     String    @map("source_symbol") @db.VarChar(50)
  sourceConfidence Decimal   @map("source_confidence") @db.Decimal(3, 2)
  isPrimary        Boolean   @default(false) @map("is_primary")
  validFrom        DateTime  @default(now()) @map("valid_from")
  validTo          DateTime? @map("valid_to")
  createdAt        DateTime  @default(now()) @map("created_at")

  instrument Instrument @relation(fields: [canonicalId], references: [canonicalId])

  @@unique([sourceTable, sourceSymbol])
  @@index([canonicalId])
  @@map("symbol_mapping")
  @@schema("metadata")
}

