  content            String?
  url                String?
  author             String?   @db.VarChar(200)
  source             String?   @db.VarChar(100)
  document_type      String?   @db.VarChar(100)
  zl_sentiment       String?   @db.VarChar(50)
  specialist_tags    String[]  @default([])
  ingested_at        DateTime? @default(now()) @db.Timestamptz(6)
  knowledge_time     DateTime? @default(now()) @db.Timestamptz(6)
  row_hash           String?   @db.VarChar(64)
  raw_payload        Json?
  ingestion_batch_id String?   @db.Uuid

  @@index([event_date], map: "idx_executive_actions_date")
  @@index([specialist_tags], map: "idx_executive_actions_tags", type: Gin)
  @@index([document_type], map: "idx_executive_actions_type")
  @@map("executive_actions_event")
  @@schema("alt")
}

