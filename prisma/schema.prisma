/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model profarmer_news {
  id               Int       @id @default(autoincrement())
  event_date       DateTime  @db.Date
  section          String    @db.VarChar(100)
  headline         String
  content          String?
  url              String    @unique @db.VarChar(500)
  author           String?   @db.VarChar(200)
  specialist_tags  String[]
  ingested_at      DateTime? @default(now()) @db.Timestamptz(6)
  row_hash         String    @unique @db.VarChar(64)
  raw_payload      Json?
  summary          String?
  topics           String[]
  subjects         String[]
  meta_description String?
  subject          String?   @db.VarChar(500)
  tags             String[]
  keywords         String[]
  categories       String[]

  @@index([event_date], map: "idx_alt_profarmer_date")
  @@index([section], map: "idx_alt_profarmer_section")
  @@index([specialist_tags], map: "idx_alt_profarmer_tags", type: Gin)
  @@index([categories], map: "idx_profarmer_categories", type: Gin)
  @@index([keywords], map: "idx_profarmer_keywords", type: Gin)
  @@index([tags], map: "idx_profarmer_tags", type: Gin)
  @@index([topics], map: "idx_profarmer_topics", type: Gin)
  @@map("profarmer_news_event")
  @@schema("alt")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model tariff_deadlines {
  id                  Int       @id @default(autoincrement())
  deadline_name       String    @db.VarChar(100)
  deadline_date       DateTime  @db.Date
  days_to_expiry      Int
  renewal_probability Decimal?  @db.Decimal(5, 4)
  policy_type         String?   @db.VarChar(50)
  description         String?
  is_active           Boolean?  @default(true)
  last_updated        DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([deadline_name, deadline_date])
  @@index([is_active], map: "idx_alt_tariff_deadline_active")
  @@index([deadline_date], map: "idx_alt_tariff_deadline_date")
  @@map("tariff_deadlines_static")
  @@schema("alt")
}

