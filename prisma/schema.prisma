generator client {
  provider        = "prisma-client-js"
  output          = "./generated/prisma"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  schemas  = ["alt", "analytics", "econ", "features", "forecasts", "mkt", "model", "ops", "pos", "supply", "training", "vegas"]
}

model econ_news {
  id               Int       @id @default(autoincrement())
  article_id       String?   @db.VarChar(100)
  event_date       DateTime  @db.Date
  published_at     DateTime? @db.Timestamptz(6)
  headline         String
  summary          String?
  content          String?
  source           String?   @db.VarChar(50)
  url              String?
  author           String?   @db.VarChar(200)
  specialist_tags  String[]
  topics           String[]
  subjects         String[]
  meta_description String?
  raw_payload      Json?
  ingested_at      DateTime? @default(now()) @db.Timestamptz(6)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)

  @@index([event_date], map: "idx_alt_econ_news_date")
  @@index([published_at], map: "idx_alt_econ_news_published_at")
  @@index([specialist_tags], map: "idx_alt_econ_news_tags", type: Gin)
  @@map("econ_news_event")
  @@schema("alt")
}

model executive_actions {
  id                 Int       @id @default(autoincrement())
  article_id         String?   @db.VarChar(100)
  event_date         DateTime  @db.Date
  published_at       DateTime? @db.Timestamptz(6)
