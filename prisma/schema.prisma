model TrainingFeatures1d {
  id       Int      @id @default(autoincrement())
  asOfDate DateTime @unique(map: "core_features_as_of_date_key") @map("as_of_date")
  features Json

  @@index([asOfDate], map: "core_features_as_of_date_idx")
  @@map("features_1d")
  @@schema("training")
}

model OofCore1d {
  id            Int      @id @default(autoincrement())
  tradeDate     DateTime @map("trade_date") @db.Date
  symbol        String   @default("ZL") @db.VarChar(20)
  horizonDays   Int      @map("horizon_days")
  windowId      Int      @map("window_id")
  cutoffDate    DateTime @map("cutoff_date") @db.Date
  p30           Float
  p50           Float
  p70           Float
  targetValue   Float?   @map("target_value")
  trainedAt     DateTime @default(now()) @map("trained_at") @db.Timestamp(6)
  runHash       String   @map("run_hash") @db.VarChar(64)
  matrixVersion String?  @map("matrix_version") @db.VarChar(64)

  @@unique([tradeDate, symbol, horizonDays, windowId])
  @@index([tradeDate], map: "idx_oof_core_date")
  @@index([horizonDays], map: "idx_oof_core_horizon")
  @@index([runHash], map: "idx_oof_core_run")
  @@map("oof_core_1d")
  @@schema("training")
}

model MetaInputs1d {
  id               Int      @id @default(autoincrement())
  tradeDate        DateTime @map("trade_date") @db.Date
  symbol           String   @default("ZL") @db.VarChar(20)
  horizonDays      Int      @map("horizon_days")
  coreP30          Float?   @map("core_p30")
  coreP50          Float?   @map("core_p50")
  coreP70          Float?   @map("core_p70")
  biofuel_p30      Float?
  biofuel_p50      Float?
  biofuel_p70      Float?
  china_p30        Float?
  china_p50        Float?
  china_p70        Float?
  crush_p30        Float?
  crush_p50        Float?
  crush_p70        Float?
  energy_p30       Float?
  energy_p50       Float?
  energy_p70       Float?
  fed_p30          Float?
  fed_p50          Float?
  fed_p70          Float?
  fx_p30           Float?
  fx_p50           Float?
  fx_p70           Float?
  palm_p30         Float?
  palm_p50         Float?
  palm_p70         Float?
  substitutes_p30  Float?
  substitutes_p50  Float?
  substitutes_p70  Float?
  tariff_p30       Float?
  tariff_p50       Float?
  tariff_p70       Float?
  trump_effect_p30 Float?
  trump_effect_p50 Float?
  trump_effect_p70 Float?
  volatility_p30   Float?
  volatility_p50   Float?
  volatility_p70   Float?
  targetValue      Float?   @map("target_value")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([tradeDate, symbol, horizonDays])
  @@index([tradeDate], map: "idx_meta_inputs_date")
  @@index([horizonDays], map: "idx_meta_inputs_horizon")
  @@map("meta_inputs_1d")
  @@schema("training")
}

model RealizedVolatility {
  id             Int       @id @default(autoincrement())
  symbol         String    @db.VarChar(20)
  asOfDate       DateTime  @map("as_of_date") @db.Date
  windowDays     Int       @map("window_days")
  realizedVol    Float     @map("realized_vol")
  parkinsonVol   Float?    @map("parkinson_vol")
  garmanKlassVol Float?    @map("garman_klass_vol")
  yangZhangVol   Float?    @map("yang_zhang_vol")
  annualized     Boolean?  @default(true)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([symbol, asOfDate, windowDays])
  @@index([asOfDate], map: "idx_realized_vol_date")
  @@index([symbol], map: "idx_realized_vol_symbol")
  @@map("realized_volatility")
  @@schema("training")
}

model SpecialistFeatures {
  id       Int      @id @default(autoincrement())
  bucket   String
  asOfDate DateTime @map("as_of_date")
  features Json

  @@unique([bucket, asOfDate])
  @@index([asOfDate])
  @@index([bucket])
  @@map("specialist_features")
  @@schema("training")
}

model VolatilitySurface {
  id           Int       @id @default(autoincrement())
  underlying   String?   @db.VarChar(10)
  asOfDate     DateTime? @map("as_of_date") @db.Date
  surfaceData  Json?     @map("surface_data")
  atmVol       Decimal?  @map("atm_vol") @db.Decimal(8, 6)
  skew25d      Decimal?  @map("skew_25d") @db.Decimal(8, 6)
  butterfly25d Decimal?  @map("butterfly_25d") @db.Decimal(8, 6)
  termSlope    Decimal?  @map("term_slope") @db.Decimal(8, 6)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([underlying, asOfDate])
  @@index([asOfDate], map: "idx_vol_surface_date")
  @@index([underlying], map: "idx_vol_surface_underlying")
  @@map("volatility_surface")
  @@schema("training")
}

model SpecialistTrumpEffect1d {
  id         Int       @id @default(autoincrement())
  asOfDate   DateTime  @map("as_of_date") @db.Date
  symbol     String?   @default("ZL") @db.VarChar(20)
  signal     Float?
  confidence Float?
  features   Json?
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([asOfDate, symbol])
  @@index([asOfDate], map: "idx_trump_1d_date")
  @@index([asOfDate], map: "idx_trump_effect_1d_date")
  @@index([asOfDate], map: "idx_trump_effect_date")
  @@map("specialist_trump_effect_1d")
  @@schema("training")
}

model SpecialistTrumpEffect1h {
  id         Int       @id @default(autoincrement())
  as_of_date DateTime  @db.Timestamp(6)
  symbol     String?   @default("ZL") @db.VarChar(20)
  signal     Float?
  confidence Float?
  features   Json?
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([as_of_date, symbol])
  @@index([as_of_date], map: "idx_trump_1h_date")
  @@index([as_of_date], map: "idx_trump_effect_1h_date")
  @@map("specialist_trump_effect_1h")
  @@schema("analytics")
}

model ModelRegistry {
  id                  Int       @id @default(autoincrement())
  modelId             String    @map("model_id")
  modelName           String    @map("model_name")
  modelType           String    @map("model_type")
  horizon             Int?
  version             Int       @default(1)
  trainedAt           DateTime  @default(now()) @map("trained_at") @db.Timestamptz(6)
  trainingMode        String?   @map("training_mode")
  trainingTimeSeconds Decimal?  @map("training_time_seconds") @db.Decimal
  datasetRows         Int?      @map("dataset_rows")
  datasetFeatures     Int?      @map("dataset_features")
  datasetStartDate    DateTime? @map("dataset_start_date") @db.Date
  datasetEndDate      DateTime? @map("dataset_end_date") @db.Date
  mase                Decimal?  @db.Decimal
  rmse                Decimal?  @db.Decimal
  mae                 Decimal?  @db.Decimal
  mape                Decimal?  @db.Decimal
  pinballLossP10      Decimal?  @map("pinball_loss_p10") @db.Decimal
  pinballLossP50      Decimal?  @map("pinball_loss_p50") @db.Decimal
  pinballLossP90      Decimal?  @map("pinball_loss_p90") @db.Decimal
  coverage80          Decimal?  @map("coverage_80") @db.Decimal
  bestModel           String?   @map("best_model")
  modelsTrained       Int?      @map("models_trained")
  status              String    @default("trained")
  isChampion          Boolean?  @default(false) @map("is_champion")
  promotedAt          DateTime? @map("promoted_at") @db.Timestamptz(6)
  artifactPath        String?   @map("artifact_path")
  mlflowRunId         String?   @map("mlflow_run_id")
  tags                Json?     @default("{}")
  notes               String?
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([modelId, version])
  @@index([horizon], map: "idx_registry_horizon")
  @@index([isChampion], map: "idx_registry_is_champion")
  @@index([modelType], map: "idx_registry_model_type")
  @@index([status], map: "idx_registry_status")
  @@index([trainedAt], map: "idx_registry_trained_at")
  @@map("model_registry")
  @@schema("model")
}

model ChartOverlays {
  id          Int       @id @default(autoincrement())
  symbol      String
  overlayType String    @map("overlay_type")
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  label       String
  color       String?
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([overlayType])
  @@index([startDate])
  @@index([symbol])
  @@map("chart_overlays")
  @@schema("analytics")
}

model DashboardMetrics {
  id          Int       @id @default(autoincrement())
  metricName  String    @map("metric_name")
  metricValue Decimal?  @map("metric_value") @db.Decimal(18, 6)
  asOfDate    DateTime? @map("as_of_date") @db.Date
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("dashboard_metrics")
  @@schema("analytics")
}

model DriverScores {
  id               Int       @id @default(autoincrement())
  asOfDate         DateTime  @map("as_of_date") @db.Date
  specialist       String
  signal           Decimal?  @db.Decimal(10, 6)
  direction        String?
  confidence       Decimal?  @db.Decimal(10, 6)
  shapContribution Decimal?  @map("shap_contribution") @db.Decimal(10, 6)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([asOfDate, specialist])
  @@map("driver_scores")
  @@schema("analytics")
}

model MarketPosture {
  id           Int       @id @default(autoincrement())
  asOfDate     DateTime  @map("as_of_date") @db.Date
  horizon      Int
  posture      String?
  confidence   Decimal?  @db.Decimal(10, 6)
  regime       String?
  tailRiskProb Decimal?  @map("tail_risk_prob") @db.Decimal(10, 6)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([asOfDate, horizon])
  @@map("market_posture")
  @@schema("analytics")
}

model ProcurementActions {
  id         Int      @id @default(autoincrement())
  symbol     String
  asOfDate   DateTime @map("as_of_date")
  action     String
  confidence Float
  rationale  String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([symbol, asOfDate])
  @@index([asOfDate])
  @@index([symbol])
  @@map("procurement_actions")
  @@schema("analytics")
}

model RiskMetrics {
  id           Int       @id @default(autoincrement())
  asOfDate     DateTime  @map("as_of_date") @db.Timestamp(6)
  horizon      Int
  var01        Float     @map("var_01")
  var05        Float     @map("var_05")
  var10        Float     @map("var_10")
  cvar05       Float     @map("cvar_05")
  probUp       Float     @map("prob_up")
  probUp5pct   Float     @map("prob_up_5pct")
  probDown5pct Float     @map("prob_down_5pct")
  regime       String    @db.VarChar(20)
  tailRiskFlag Boolean   @map("tail_risk_flag")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([asOfDate, horizon])
  @@map("risk_metrics")
  @@schema("analytics")
}

model ScenarioAnalysis {
  id               Int       @id @default(autoincrement())
  scenarioId       String    @map("scenario_id") @db.VarChar(100)
  scenarioName     String    @map("scenario_name") @db.VarChar(200)
  asOfDate         DateTime  @map("as_of_date") @db.Date
  horizon          Int
  assumptions      Json
  baseForecast     Float?    @map("base_forecast")
  scenarioForecast Float?    @map("scenario_forecast")
  impactPct        Float?    @map("impact_pct")
  probability      Float?
  confidence       String?   @db.VarChar(20)
  modelVersion     String?   @map("model_version") @db.VarChar(100)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([scenarioId, asOfDate, horizon])
  @@index([asOfDate], map: "idx_scenario_date")
  @@map("scenario_analysis")
  @@schema("analytics")
}

model ValueTimingWindows {
  id                     Int      @id @default(autoincrement())
  symbol                 String
  asOfDate               DateTime @map("as_of_date")
  horizonDays            Int      @map("horizon_days")
