generator client {
  provider        = "prisma-client-js"
  output          = "./generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["analytics", "archive", "features", "forecasts", "gold", "metadata", "model", "ops", "raw", "silver", "training"]
}

model CftcCot1w {
  id                   Int       @id(map: "cftc_cot_pkey") @default(autoincrement())
  eventDate            DateTime  @map("event_date") @db.Date
  symbol               String    @db.VarChar(20)
  openInterest         BigInt?   @map("open_interest")
  prodMercLong         BigInt?   @map("prod_merc_long")
  prodMercShort        BigInt?   @map("prod_merc_short")
  swapLong             BigInt?   @map("swap_long")
  swapShort            BigInt?   @map("swap_short")
  managedMoneyLong     BigInt?   @map("managed_money_long")
  managedMoneyShort    BigInt?   @map("managed_money_short")
  otherReptLong        BigInt?   @map("other_rept_long")
  otherReptShort       BigInt?   @map("other_rept_short")
  nonreptLong          BigInt?   @map("nonrept_long")
  nonreptShort         BigInt?   @map("nonrept_short")
  prodMercNet          BigInt?   @map("prod_merc_net")
  swapNet              BigInt?   @map("swap_net")
  managedMoneyNet      BigInt?   @map("managed_money_net")
  otherReptNet         BigInt?   @map("other_rept_net")
  nonreptNet           BigInt?   @map("nonrept_net")
  managedMoneyNetPctOi Float?    @map("managed_money_net_pct_oi")
  prodMercNetPctOi     Float?    @map("prod_merc_net_pct_oi")
  source               String?   @db.VarChar(50)
  ingestedAt           DateTime? @default(now()) @map("ingested_at") @db.Timestamp(6)
  knowledgeTime        DateTime? @default(now()) @map("knowledge_time") @db.Timestamptz(6)
  revisionNo           Int?      @default(1) @map("revision_no")
  supersedesId         Int?      @map("supersedes_id")
  isPreliminary        Boolean?  @default(true) @map("is_preliminary")
  validationStatus     String?   @default("validated") @map("validation_status") @db.VarChar(20)
  qualityScore         Int?      @map("quality_score")
  anomalyFlags         String[]  @map("anomaly_flags")
  sourceUrl            String?   @map("source_url") @db.VarChar
  rawPayload           Json?     @map("raw_payload")
  ingestionBatchId     String?   @map("ingestion_batch_id") @db.VarChar
  rowHash              String?   @map("row_hash") @db.VarChar(64)
  specialistTags       String[]  @map("specialist_tags")

  @@index([eventDate], map: "idx_cftc_date")
  @@index([knowledgeTime], map: "idx_cftc_knowledge_time")
  @@index([rowHash], map: "idx_cftc_row_hash")
  @@index([specialistTags], map: "idx_cftc_specialist_tags", type: Gin)
  @@index([symbol], map: "idx_cftc_symbol")
  @@index([symbol, eventDate], map: "idx_cftc_symbol_event")
  @@map("cftc_cot_1w")
  @@schema("raw")
}

