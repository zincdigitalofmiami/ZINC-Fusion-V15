// =============================================================================
// VEGAS INTEL - Owned Tables (Our data, not from Glide)
// =============================================================================
// These tables store data WE create and maintain for Vegas Intel features.
// Event calendar, behavioral model profiles, intel sheet tracking, etc.
// =============================================================================

model VegasEvent {
  id            Int       @id @default(autoincrement())
  eventId       String    @unique @map("event_id") @db.VarChar(100)
  name          String    @db.VarChar(255)
  eventType     String?   @map("event_type") @db.VarChar(100)
  venue         String?   @db.VarChar(255)
  startDate     DateTime  @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  attendance    Int?
  attendanceMin Int?      @map("attendance_min")
  attendanceMax Int?      @map("attendance_max")
  source        String?   @db.VarChar(50)
  sourceUrl     String?   @map("source_url") @db.VarChar(500)
  rawPayload    Json?     @map("raw_payload") @db.JsonB
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([startDate], map: "idx_vegas_events_start_date")
  @@index([eventType], map: "idx_vegas_events_type")
  @@index([isActive], map: "idx_vegas_events_active")
  @@map("vegas_events")
  @@schema("ops")
}

model VegasEventProfile {
  id              Int       @id @default(autoincrement())
  eventType       String    @unique @map("event_type") @db.VarChar(100)
  displayName     String    @map("display_name") @db.VarChar(255)
  primaryDemo     String?   @map("primary_demo") @db.VarChar(255)
  psychographic   String?   @db.VarChar(255)
  cuisineAffinity Json?     @map("cuisine_affinity") @db.JsonB
  avgSpendTier    String?   @map("avg_spend_tier") @db.VarChar(50)
  peakDiningHours String?   @map("peak_dining_hours") @db.VarChar(100)
  notes           String?   @db.Text
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("vegas_event_profiles")
  @@schema("ops")
}

model VegasCasinoProfile {
  id         Int       @id @default(autoincrement())
  casinoName String    @unique @map("casino_name") @db.VarChar(255)
  vibe       String?   @db.VarChar(100)
  pullFactor Float?    @map("pull_factor")
  targetDemo String?   @map("target_demo") @db.VarChar(255)
  tier       String?   @db.VarChar(50)
  corridor   String?   @db.VarChar(100)
  notes      String?   @db.Text
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("vegas_casino_profiles")
  @@schema("ops")
}

model VegasCuisineMatch {
  id            Int       @id @default(autoincrement())
  eventType     String    @map("event_type") @db.VarChar(100)
  cuisineType   String    @map("cuisine_type") @db.VarChar(100)
  affinityScore Float     @map("affinity_score")
  notes         String?   @db.Text
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([eventType, cuisineType])
  @@index([eventType], map: "idx_vegas_cuisine_match_event_type")
  @@map("vegas_cuisine_match")
  @@schema("ops")
}

model VegasIntelSheet {
  id           Int       @id @default(autoincrement())
  sheetId      String    @unique @map("sheet_id") @db.VarChar(100)
  restaurantId String?   @map("restaurant_id") @db.VarChar(100)
  eventId      String?   @map("event_id") @db.VarChar(100)
  sheetType    String    @map("sheet_type") @db.VarChar(50)
  headline     String?   @db.VarChar(500)
  content      Json?     @db.JsonB
  shareableUrl String?   @map("shareable_url") @db.VarChar(500)
  pdfUrl       String?   @map("pdf_url") @db.VarChar(500)
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at") @db.Timestamptz(6)
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(6)
  sentTo       String?   @map("sent_to") @db.VarChar(255)
  status       String    @default("draft") @db.VarChar(50)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([restaurantId], map: "idx_vegas_intel_sheets_restaurant")
  @@index([eventId], map: "idx_vegas_intel_sheets_event")
  @@index([status], map: "idx_vegas_intel_sheets_status")
  @@map("vegas_intel_sheets")
  @@schema("ops")
}

model VegasCustomerScore {
  id               Int       @id @default(autoincrement())
  restaurantId     String    @unique @map("restaurant_id") @db.VarChar(100)
  casinoId         String?   @map("casino_id") @db.VarChar(100)
  isCustomer       Boolean   @default(false) @map("is_customer")
  priorityScore    Float?    @map("priority_score")
  atRiskScore      Float?    @map("at_risk_score")
  daysSinceOrder   Int?      @map("days_since_order")
  orderPattern     String?   @map("order_pattern") @db.VarChar(100)
  volumeTrend      String?   @map("volume_trend") @db.VarChar(50)
  lastOrderDate    DateTime? @map("last_order_date") @db.Date
  avgOrderValue    Float?    @map("avg_order_value")
  fryerCount       Int?      @map("fryer_count")
  eventImpactScore Float?    @map("event_impact_score")
  oneLiner         String?   @map("one_liner") @db.VarChar(500)
  computedAt       DateTime? @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@index([isCustomer], map: "idx_vegas_customer_scores_is_customer")
  @@index([priorityScore], map: "idx_vegas_customer_scores_priority")
  @@index([atRiskScore], map: "idx_vegas_customer_scores_at_risk")
  @@map("vegas_customer_scores")
  @@schema("ops")
}

model VegasActivityLog {
  id           Int       @id @default(autoincrement())
  activityType String    @map("activity_type") @db.VarChar(50)
  entityType   String    @map("entity_type") @db.VarChar(50)
  entityId     String    @map("entity_id") @db.VarChar(100)
  userId       String?   @map("user_id") @db.VarChar(100)
  details      Json?     @db.JsonB
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([activityType], map: "idx_vegas_activity_log_type")
  @@index([entityType, entityId], map: "idx_vegas_activity_log_entity")
  @@index([createdAt], map: "idx_vegas_activity_log_created")
  @@map("vegas_activity_log")
  @@schema("ops")
}
