# Local audit routing (safe template)
# Copy to .env.local.audit and fill credentials.

# Local runtime and shadow database identities
LOCAL_DATABASE_URL="postgresql://<user>:<pass>@localhost:5432/zinc_fusion_v15_local"
SHADOW_DATABASE_URL="postgresql://<user>:<pass>@localhost:5432/zinc_fusion_v15_shadow"
LOCAL_DB_EXPECTED_NAME="zinc_fusion_v15_local"
EXPECTED_DB_NAME="zinc_fusion_v15_local"
SHADOW_DB_EXPECTED_NAME="zinc_fusion_v15_shadow"

# Cloud reference (used by sync/guard scripts)
CLOUD_DATABASE_URL="postgresql://<cloud_user>:<cloud_pass>@db.prisma.io:5432/postgres?sslmode=require&gssencmode=disable"
EXPECTED_CLOUD_DB_HOST="db.prisma.io"

# Route runtime aliases to local during audit sessions
DB_ROUTING_MODE="dual"
DIRECT_DATABASE_URL="${LOCAL_DATABASE_URL}"
POSTGRES_URL="${LOCAL_DATABASE_URL}"
DATABASE_URL="${LOCAL_DATABASE_URL}"

# Inngest local SDK target (used by docker-compose.inngest.yml)
# Override when frontend dev server is not on :3000.
INNGEST_DEV_URL="http://host.docker.internal:3000/api/inngest"
