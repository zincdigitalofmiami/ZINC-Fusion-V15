# Binary model artifacts — skip diff, mark as generated
*.pkl binary linguist-generated
*.onnx binary linguist-generated
*.pt binary linguist-generated
*.bin binary linguist-generated
*.joblib binary linguist-generated
*.h5 binary linguist-generated
*.safetensors binary linguist-generated

# Data files
*.parquet binary linguist-generated
*.csv linguist-generated
*.feather binary linguist-generated

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg linguist-vendored

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
