frontend/package-lock.json linguist-generated
uv.lock linguist-generated

# Prisma generated client — skip review
prisma/generated/** linguist-generated

# Test results — generated
frontend/test-results/** linguist-generated

# Model directories — treat everything in models/ as generated binary
models/**/*.pkl binary linguist-generated
