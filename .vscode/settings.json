{
  "notebook.experimental.remoteSave": false,

  "python.languageServer": "Pylance",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.typeCheckingMode": "basic",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "python.analysis.autoImportCompletions": true,

  "editor.rulers": [88, 120],
  "editor.parameterHints.enabled": true,
  "editor.hover.enabled": true,
  "editor.suggestOnTriggerCharacters": true,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "editor.wordBasedSuggestions": "currentDocument",
  "editor.formatOnSave": true,

  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "always",
      "source.organizeImports.ruff": "always"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.wordWrap": "on"
  },
  "[prisma]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Prisma.prisma"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "files.associations": {
    "*.md": "markdown",
    "*.sql": "sql",
    "*.yaml": "yaml",
    "AGENTS.md": "markdown"
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true,
    "AutogluonModels": true,
    ".venv": false
  },

  "search.exclude": {
    ".venv/**": true,
    "AutogluonModels/**": true,
    "**/node_modules/**": true,
    "frontend/.next/**": true,
    "client/.next/**": true,
    "data/**": true,
    "data-alloy/**": true,
    "logs/**": true,
    "reports/**": true,
    "archive/**": true,
    "models/**": true,
    "grafana/**": true,
    "docker/**": true,
    "fly/**": true,
    "*.csv": true,
    "*.parquet": true,
    "*.pkl": true,
    "*.joblib": true
  },

  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "python": true,
    "typescript": true,
    "prisma": true
  },

  "chat.agent.enabled": true,

  "typescript.suggest.enabled": true,
  "javascript.suggest.enabled": true,
  "typescript.preferences.importModuleSpecifier": "relative",

  "json.validate.enable": true,
  "yaml.validate": true,

  "prisma.enableCodeLens": true,
  "prisma.trace.server": "messages",

  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["-q"],
  "python.testing.unittestEnabled": false,
  "chat.mcp.autostart": true,
  "codescene.enableAutoRefactor": true,
  "codescene.enableReviewCodeLenses": true,

  "github.copilot.chat.codeGeneration.instructions": [
    { "file": "AGENTS.md" }
  ],
  "github.copilot.chat.reviewSelection.instructions": [
    { "file": "AGENTS.md" }
  ],
  "github.copilot.chat.testGeneration.instructions": [
    { "file": "AGENTS.md" }
  ],

  "chat.instructions": [
    {
      "text": "Follow AGENTS.md as the single source of truth for architecture and terminology. If AGENTS.md conflicts with any other file, AGENTS.md wins. Use memory MCP when available; if it is unavailable, state that explicitly and continue with local evidence. Never fabricate schemas, files, tables, endpoints, or metrics. Make only requested changes and report every file touched."
    }
  ]
}
