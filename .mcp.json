{
  "mcpServers": {
    "memory": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": "/Volumes/Satechi Hub/ZINC-FUSION-V15/.claude/memory.jsonl"
      }
    },
    "context7": {
      "type": "sse",
      "url": "http://localhost:18081/sse"
    },
    "sequentialthinking": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "cubic": {
      "type": "http",
      "url": "https://www.cubic.dev/api/mcp",
      "headers": {
        "Authorization": "Bearer ${CUBIC_API_KEY}"
      }
    },
    "postgres": {
      "command": "uvx",
      "args": ["postgres-mcp", "${DATABASE_URL}", "--access-mode=restricted"]
    }
  }
}
