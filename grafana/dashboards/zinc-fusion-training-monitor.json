      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
          "expr": "node_memory_wired_bytes{job=\"integrations/macos-node\"}",
          "legendFormat": "Wired",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
          "expr": "node_memory_compressed_bytes{job=\"integrations/macos-node\"}",
          "legendFormat": "Compressed",
          "refId": "B"
