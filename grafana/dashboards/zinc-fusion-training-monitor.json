        {
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
          "expr": "node_memory_internal_bytes{job=\"integrations/macos-node\"}",
          "legendFormat": "Internal (App)",
          "refId": "C"
        }
      ],
      "title": "Memory Usage (Watch for Pressure)",
      "type": "timeseries"
    },
