// ============================================================================
// ZINC-Fusion Enhanced Alloy Configuration
// ============================================================================
// Based on Grafana Cloud macOS integration with added training monitoring
//
// USAGE:
// 1. Run the Grafana Cloud install script first (creates base config)
// 2. Append this file's contents to: /opt/homebrew/etc/alloy/config.alloy
// 3. Restart alloy: brew services restart alloy
// ============================================================================

// ============================================================================
// ZINC-FUSION TRAINING LOG COLLECTION
// ============================================================================
// Captures training script output for correlation with system metrics

local.file_match "zinc_fusion_training_logs" {
  path_targets = [
    {
      __path__    = "/Volumes/Satechi Hub/ZINC-FUSION-V15/logs/*.log",
      __address__ = "localhost",
      instance    = constants.hostname,
      job         = "zinc-fusion/training",
      app         = "zinc-fusion",
    },
  ]
}

loki.process "zinc_fusion_training_logs" {
  forward_to = [loki.write.grafana_cloud_loki.receiver]

  // Parse training log lines
  stage.regex {
    expression = "^(?P<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2},\\d{3}) - (?P<level>\\w+) - (?P<message>.*)$"
  }

  stage.labels {
    values = {
      level = null,
    }
  }

  // Extract model/horizon info from messages
  stage.regex {
    expression = "(?P<horizon>\\d+d)|(?P<window>Window \\d+)|(?P<imf>IMF \\d+)|(?P<mae>MAE[: ]+[\\d.]+)"
  }

  stage.labels {
    values = {
      horizon = null,
    }
  }
}

loki.source.file "zinc_fusion_training_logs" {
  targets    = local.file_match.zinc_fusion_training_logs.targets
  forward_to = [loki.process.zinc_fusion_training_logs.receiver]
}

// ============================================================================
// PYTHON PROCESS MONITORING
// ============================================================================
// Track Python training processes - CPU, memory, file descriptors

prometheus.exporter.process "python_training" {
  track_children = true
  track_threads  = true

  matcher {
    name    = "python_training"
    cmdline = [".*python.*train.*"]
  }

  matcher {
    name    = "python_ga_vmd_lstm"
    cmdline = [".*python.*ga_vmd_lstm.*"]
  }

  matcher {
    name    = "python_autogluon"
    cmdline = [".*python.*autogluon.*"]
  }

  matcher {
    name    = "python_chronos"
    cmdline = [".*chronos.*"]
  }
}

discovery.relabel "python_training" {
  targets = prometheus.exporter.process.python_training.targets

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  rule {
    target_label = "job"
    replacement  = "zinc-fusion/python-processes"
  }
}

prometheus.scrape "python_training" {
  targets         = discovery.relabel.python_training.output
  forward_to      = [prometheus.remote_write.metrics_service.receiver]
  scrape_interval = "10s"
  job_name        = "zinc-fusion/python-processes"
}

// ============================================================================
// TASK OUTPUT MONITORING (Background training tasks)
// ============================================================================

local.file_match "zinc_fusion_task_outputs" {
  path_targets = [
    {
      __path__    = "/private/tmp/claude/-Volumes-Satechi-Hub-ZINC-FUSION-V15/tasks/*.output",
      __address__ = "localhost",
      instance    = constants.hostname,
      job         = "zinc-fusion/task-output",
      app         = "zinc-fusion",
    },
  ]
}

loki.source.file "zinc_fusion_task_outputs" {
  targets    = local.file_match.zinc_fusion_task_outputs.targets
  forward_to = [loki.write.grafana_cloud_loki.receiver]
}

