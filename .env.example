# Environment Variables Template
# Copy to .env and fill in actual values

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://user:password@host:port/database

# ============================================================================
# SECURITY (NEW - REQUIRED FOR CRITICAL FIXES)
# ============================================================================

# API Key for business logic endpoints (NEW in 2026-02-13 deployment)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Required for: /api/dashboard/summary, /api/market/zl, /api/forecast/*, etc.
FUSION_API_KEY=

# API Token for database explorer endpoints (existing)
# Required for: /api/db/query, /api/db/tables, /api/db/columns
FUSION_API_TOKEN=

# ============================================================================
# API CORS
# ============================================================================

# Comma-separated list of allowed origins
# Example: https://app.example.com,https://staging.example.com
FUSION_CORS_ORIGINS=

# ============================================================================
# DATA API KEYS
# ============================================================================

# Federal Reserve Economic Data API
# Get key from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Databento Market Data API (for intraday ZL data)
# Get key from: https://databento.com
DATABENTO_API_KEY=

# ============================================================================
# INNGEST (Frontend/Vercel only)
# ============================================================================

# Inngest Event Key (for sending events)
INNGEST_EVENT_KEY=

# Inngest Signing Key (for validating incoming requests)
INNGEST_SIGNING_KEY=

# ============================================================================
# FRONTEND CONFIGURATION (Frontend/Vercel only)
# ============================================================================

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================================
# NOTES
# ============================================================================

# Development Mode:
# - If FUSION_API_KEY is not set, API authentication is disabled with warning
# - Useful for local development without managing keys
#
# Production Mode:
# - FUSION_API_KEY must be set
# - All protected endpoints require X-API-Key header
#
# Security Best Practices:
# - Never commit this file with actual values
# - Use different keys for staging and production
# - Rotate keys quarterly
# - Store keys in secure vault (1Password, AWS Secrets Manager, etc.)
#
# Deployment:
# - Set these in Vercel environment variables dashboard
# - Or use: vercel env add <variable-name> <environment>
